# Copia este archivo a .env y nunca confirmes la clave real.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_RETRY_ATTEMPTS=2
GEMINI_THINKING_LEVEL=high
LLM_TIMEOUT_SECONDS=90
# Language of the report, fixed texts and Gemini's answers: en or es (default es).
REPORT_LANGUAGE=es

SOC_AUTO_INVESTIGATE=true
