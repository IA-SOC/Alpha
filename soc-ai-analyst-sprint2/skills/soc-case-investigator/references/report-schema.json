{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soc-investigation-report:schema:1.1",
  "title": "SOC Investigation Report",
  "type": "object",
  "required": [
    "case_id",
    "input",
    "executive_summary",
    "attack_mapping",
    "hypotheses",
    "timeline",
    "blast_radius",
    "enrichment",
    "recommended_actions",
    "limitations",
    "review"
  ],
  "properties": {
    "methodology": {
      "type": "object",
      "required": ["report_schema"],
      "properties": {"report_schema": {"const": "urn:soc-investigation-report:schema:1.1"}},
      "additionalProperties": true
    },
    "case_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "input": {
      "type": "object",
      "required": ["source_format", "alert_count", "processed_alert_count"],
      "properties": {
        "source_format": {"enum": ["elastic_ecs", "elastic_security", "wazuh", "mixed", "unknown"]},
        "schema_version": {"type": ["string", "null"]},
        "alert_count": {"type": "integer", "minimum": 0},
        "processed_alert_count": {"type": "integer", "minimum": 0},
        "time_window_utc": {"type": ["object", "null"]},
        "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      },
      "additionalProperties": true
    },
    "executive_summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "attack_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technique_name", "status", "evidence"],
        "properties": {
          "tactic": {"type": ["string", "null"]},
          "technique_id": {"type": ["string", "null"], "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
          "technique_name": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "status": {"enum": ["candidate", "supported", "not_supported", "unknown"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "source_version": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "statement", "confidence", "confidence_basis", "evidence_for", "evidence_against", "unknowns"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "confidence": {"enum": ["alta", "media", "baja", "insuficiente"]},
          "confidence_percentage": false,
          "confidence_percent": false,
          "confidence_score": false,
          "confidence_probability": false,
          "probability": false,
          "confidence_basis": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_for": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/evidence"}, {"properties": {"role": {"const": "supporting"}}}]}},
          "evidence_against": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/evidence"}, {"properties": {"role": {"const": "contradicting"}}}]}},
          "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
        },
        "allOf": [
          {
            "if": {"properties": {"confidence": {"enum": ["baja", "media", "alta"]}}},
            "then": {"properties": {"evidence_for": {"minItems": 1}}}
          },
          {
            "anyOf": [
              {"properties": {"evidence_for": {"minItems": 1}}},
              {"properties": {"evidence_against": {"minItems": 1}}}
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp_original", "description", "alert_ids", "certainty"],
        "properties": {
          "timestamp_original": {"type": ["string", "null"]},
          "timestamp_utc": {"type": ["string", "null"]},
          "timezone_unknown": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "certainty": {"enum": ["observed", "inferred", "unknown"]}
        },
        "additionalProperties": true
      }
    },
    "blast_radius": {
      "type": "object",
      "required": ["observed_assets", "confirmed_assets", "suspected_assets", "unknowns"],
      "properties": {
        "observed_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset", "basis_alert_ids", "observed_activity"],
            "properties": {
              "asset": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "basis_alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
              "observed_activity": {"type": "string", "minLength": 1, "pattern": "\\S"}
            },
            "additionalProperties": true
          }
        },
        "confirmed_assets": {
          "type": "array",
          "items": {"type": "object", "required": ["asset", "basis_alert_ids"], "properties": {"asset": {"type": "string", "minLength": 1, "pattern": "\\S"}, "basis_alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}, "additionalProperties": true}
        },
        "suspected_assets": {
          "type": "array",
          "items": {"type": "object", "required": ["asset", "basis_alert_ids"], "properties": {"asset": {"type": "string", "minLength": 1, "pattern": "\\S"}, "basis_alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}, "additionalProperties": true}
        },
        "confirmed_identities": {
          "type": "array",
          "items": {"type": "object", "required": ["identity", "basis_alert_ids"], "properties": {"identity": {"type": "string", "minLength": 1, "pattern": "\\S"}, "basis_alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}, "additionalProperties": true}
        },
        "suspected_identities": {
          "type": "array",
          "items": {"type": "object", "required": ["identity", "basis_alert_ids"], "properties": {"identity": {"type": "string", "minLength": 1, "pattern": "\\S"}, "basis_alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}, "additionalProperties": true}
        },
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      },
      "additionalProperties": true
    },
    "enrichment": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": {"enum": ["provided", "partial", "no_disponible"]},
        "items": {"type": "array", "items": {"type": "object"}},
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "action", "rationale", "evidence_ids", "requires_human_approval", "approval_status", "hypothesis_ranks"],
        "properties": {
          "priority": {"enum": ["urgent", "high", "medium", "low"]},
          "action": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "requires_human_approval": {"const": true},
          "approval_status": {"enum": ["pending"]},
          "hypothesis_ranks": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "model_review": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ok", "error", "unavailable"]},
        "items": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "validated", "corrected", "rejected"]},
        "analyst": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "run_id": {"type": ["string", "null"]},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_key", "status", "notes"],
            "properties": {
              "finding_key": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "status": {"enum": ["validated", "corrected", "rejected"]},
              "notes": {"type": "string", "minLength": 1, "pattern": "\\S"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["alert_id", "role", "observation", "relevance"],
      "properties": {
        "alert_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "role": {"enum": ["supporting", "contradicting", "context"]},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "observation": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "relevance": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
