        ],
        "summary": "Read Investigation",
        "operationId": "read_investigation_api_v1_cases__case_id__investigation_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
