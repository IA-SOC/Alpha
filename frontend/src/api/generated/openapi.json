    }
  },
  "components": {
    "schemas": {
      "AcceptedCaseResponse": {
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Case Id"
          },
          "submitted_case_id": {
            "type": "string",
            "title": "Submitted Case Id"
          },
          "status": {
            "type": "string",
            "const": "accepted",
            "title": "Status",
            "default": "accepted"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "submitted_case_id"
        ],
        "title": "AcceptedCaseResponse"
      },
      "Alert": {
        "properties": {
          "alert_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Alert Id"
          },
          "source_system": {
            "type": "string",
            "enum": [
              "elastic",
              "wazuh"
            ],
            "title": "Source System"
          },
          "raw_alert": {
            "additionalProperties": true,
            "type": "object",
            "minProperties": 1,
            "title": "Raw Alert"
          },
          "source_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
            "title": "Source Version"
          },
          "ecs_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.(x|[0-9]+(\\.[0-9]+)?)$",
            "title": "Ecs Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alert_id",
          "source_system",
          "raw_alert"
        ],
        "title": "Alert"
      },
      "Correlation": {
        "properties": {
          "fields": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "title": "Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fields"
        ],
        "title": "Correlation"
      },
      "Enrichment": {
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Provider"
          },
          "observable": {
            "$ref": "#/components/schemas/Observable"
          },
          "related_alert_ids": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "title": "Related Alert Ids"
          },
          "raw_result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "observable"
        ],
        "title": "Enrichment"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "FindingDecision": {
        "properties": {
          "finding_key": {
            "type": "string",
            "minLength": 1,
            "title": "Finding Key"
          },
          "status": {
            "type": "string",
            "enum": [
              "validated",
              "corrected",
              "rejected"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_key",
          "status",
          "notes"
        ],
        "title": "FindingDecision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentCase": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "case_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Case Id"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Alerts"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "correlation": {
            "$ref": "#/components/schemas/Correlation"
          },
          "enrichments": {
            "items": {
              "$ref": "#/components/schemas/Enrichment"
            },
            "type": "array",
            "title": "Enrichments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "case_id",
          "submitted_at",
          "alerts"
        ],
        "title": "IncidentCase"
      },
      "JsonValue": {},
      "Observable": {
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Type"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "title": "Observable"
      },
      "ReviewDecision": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "validated",
              "corrected",
              "rejected"
            ],
            "title": "Status"
          },
          "analyst": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Analyst"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Notes"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingDecision"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "analyst",
          "notes"
        ],
        "title": "ReviewDecision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationIssue": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "rule",
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}
