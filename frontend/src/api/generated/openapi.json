              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{case_id}/export": {
      "get": {
        "tags": [
          "investigations"
        ],
        "summary": "Export Investigation",
        "operationId": "export_investigation_api_v1_cases__case_id__export_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
